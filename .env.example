# ── App ──
NODE_ENV=development             # development | test | production
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info                   # fatal | error | warn | info | debug
LOG_FILE_DIR=                    # vazio = só stdout; em dev, "logs" grava logs/api.<data>.<n>.log (rotação diária)
LOG_FILE_RETENTION=14            # arquivos antigos guardados
LOG_FILE_MAX_SIZE=20m            # também roda o arquivo ao passar deste tamanho
TRUST_PROXY=false                # true atrás do proxy do Render/Railway

# ── Banco (local: docker compose; produção: pooler do Supabase) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/conecta
DATABASE_POOL_MAX=10

# ── Storage (Supabase) ──
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # segredo: só no servidor
STORAGE_BUCKET_ITEMS=items
STORAGE_BUCKET_DOCS=ngo-docs

# (opcional) chave pública, para o front-end
SUPABASE_PUBLISHABLE_KEY=

# ── Auth ──
JWT_SECRET=                      # mínimo 32 caracteres aleatórios (openssl rand -base64 48)
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false              # true em produção (HTTPS); o cookie de sessão cd_session é httpOnly (ADR-13)
COOKIE_DOMAIN=                   # opcional: ex. .conectadoacoes.com.br (front em app.<dom>, API em api.<dom>)

# ── Segurança ──
CORS_ORIGIN=http://localhost:5173   # várias origens separadas por vírgula
RATE_LIMIT_MAX=120                  # requisições por janela, por usuário/IP
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10              # mais rígido em /auth/*
ITEMS_RATE_LIMIT_MAX=10              # POST /items, por usuário
MESSAGES_RATE_LIMIT_MAX=30           # POST /chats/:id/messages, por usuário
PUBLIC_RATE_LIMIT_MAX=60            # rotas /public/* (visitante sem login), por IP
BODY_LIMIT_MB=1                     # JSON; uploads têm limite próprio
UPLOAD_MAX_FILE_MB=5

# ── Docs ──
SWAGGER_ENABLED=true             # false em produção

# ── E-mail (recuperação de senha e notificações do fluxo) ──
# Provedor: Brevo (prioridade) ou Resend; um dos dois é obrigatório em produção. Sem nenhum, em dev o e-mail sai no log.
BREVO_API_KEY=                   # xkeysib-...; grátis e sem domínio próprio: só o remetente verificado no Brevo (Senders)
RESEND_API_KEY=                  # re_...; sem domínio verificado só entrega para o e-mail dono da conta Resend
EMAIL_FROM=Conecta Doações <onboarding@resend.dev>   # com Brevo: o e-mail verificado lá (ex.: Conecta Doações <seuemail@gmail.com>)
APP_URL=http://localhost:5173    # base dos links dos e-mails (ex.: APP_URL/redefinir-senha?token=…, APP_URL/chats/<item>)

# ── Seed (só npm run seed) ──
ADMIN_EMAIL=admin@conectadoacoes.local
ADMIN_PASSWORD=
SEED_DEMO=false
